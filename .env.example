# Database
DATABASE_URL=postgresql://user:password@localhost:5432/esign

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3999
NEXT_PUBLIC_NEXTAUTH_URL=http://localhost:3999
NEXTAUTH_SECRET=your-random-secret-key-minimum-32-characters
SECRET=your-random-secret-key-minimum-32-characters

# API Gateway (Optional - untuk SSO mode)
API_GATEWAY=

ESIGN_URL=

# MinIO Configuration (Optional - untuk file storage)
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_ENDPOINT=localhost
MINIO_PORT=9000

# BSrE Configuration (Optional - untuk digital signature)
ESIGN_URL=
ESIGN_NIK=
ESIGN_PASSPHRASE=
ESIGN_USERNAME=
ESIGN_PASSWORD=

# OAuth SSO Configuration (Optional - kosongkan untuk mode standalone)
# Untuk mode standalone/login lokal, kosongkan semua variable di bawah ini
# Untuk mode hybrid (lokal + SSO), isi sesuai konfigurasi OAuth server Anda

# SIMASTER OAuth
MASTER_ID=
MASTER_SECRET=
MASTER_WELLKNOWN=
MASTER_SCOPE=

# PTTPK OAuth (Optional)
PTTPK_ID=
PTTPK_SECRET=
PTTPK_WELLKNOWN=
PTTPK_SCOPE=

# Base Path (jika deploy di subdirectory)
BASE_PATH=/esign

# Admin Creation (untuk script create-admin.js)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@esign.local

NIK=
