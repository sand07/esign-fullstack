# Environment variables untuk Docker Compose
# Copy file ini ke .env di root project: cp .env.docker .env
# Edit dan sesuaikan dengan konfigurasi Anda

# ================================
# Database Configuration
# ================================
DB_PASSWORD=esign_secure_password_change_me_123!@#

# ================================
# NextAuth Configuration
# ================================
NEXTAUTH_URL=http://localhost:3999
NEXTAUTH_SECRET=generate-random-secret-minimum-32-characters-abcdefghijklmnopqrstuvwxyz123
SECRET=generate-random-secret-minimum-32-characters-abcdefghijklmnopqrstuvwxyz123

# ================================
# MinIO Configuration
# ================================
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_change_me

# ================================
# OAuth SSO (Optional - kosongkan untuk standalone)
# ================================
MASTER_ID=
MASTER_SECRET=
MASTER_WELLKNOWN=
MASTER_SCOPE=
API_GATEWAY=

# ================================
# BSrE (Optional)
# ================================
ESIGN_URL=
ESIGN_USERNAME=
ESIGN_PASSWORD=

# ================================
# Admin User (untuk create-admin.js)
# ================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@esign.local
